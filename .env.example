# ============================================================
# HotPulse 配置模板
# 使用方法：复制为 .env 并填入自己的值
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# ⚠️ .env 含密钥，已在 .gitignore 中排除，切勿提交！
# ============================================================

# ---- 服务 ----
PORT=4117
# 扫描频率（cron 表达式，默认每 30 分钟）
SCAN_CRON=*/30 * * * *
# 数据库文件路径（默认 项目根/data/hotpulse.db）
# DB_FILE=

# ---- 网络代理（可选；Node fetch 不走系统代理，需在此显式声明）----
# 例：Clash 用户填 http://127.0.0.1:7897；无代理留空即可
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# ---- AI（OpenRouter，必填才能甄别/聚类）----
# 获取：https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENRO…BASE_URL=
# 默认免费模型（零成本）；付费高质量可换 google/gemini-2.5-flash 等
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
# 限流/超时自动降级的备用模型链（逗号分隔）
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ---- Twitter/X（twitterapi.io，可选；留空则禁用该源）----
# 注册送 $0.1 免费额度：https://twitterapi.io
TWITTERAPI_IO_KEY=
# 每轮扫描 X API 最大调用次数（控费）
TWITTER_MAX_CALLS_PER_SCAN=12

# ---- 邮件通知（可选；QQ/163 用"授权码"而非登录密码）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ---- 浏览器推送（可选；生成：npx web-push generate-vapid-keys）----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
***

# ---- 阈值（也可在 Web 设置页调整）----
# 关键词命中最低置信度（0~1）
AI_NOTIFY_MIN_CONFIDENCE=0.6
# 热点话题通知分数线（0~100）
TOPIC_NOTIFY_MIN_SCORE=70
