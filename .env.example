# ============================================================
# HotPulse 配置模板
# 使用方法：复制为 .env 并填入自己的值
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
# ⚠️ .env 含密钥，已在 .gitignore 中排除，切勿提交！
# ============================================================

# ---- 服务 ----
PORT=4117
# 扫描频率（cron 表达式，默认每 30 分钟）
SCAN_CRON=*/30 * * * *
# 数据库文件路径（默认 项目根/data/hotpulse.db）
# DB_FILE=

# ---- 网络代理（可选；Node fetch 不走系统代理，需在此显式声明）----
# 例：Clash 用户填 http://127.0.0.1:7897；无代理留空即可
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1

# ---- AI（OpenRouter，必填才能甄别/聚类）----
# 获取：https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENRO…BASE_URL=
# 默认免费模型（零成本）；付费高质量可换 google/gemini-2.5-flash 等
# 注意：请选**非推理型**模型。推理模型（nemotron-super 等）会把 token 预算烧在思考上，
# 长 prompt（聚类 20 条）会超时或返回空。代码已用 reasoning:{enabled:false} 关闭思考，
# 但优先选本身不推理的模型更稳。
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# 限流/超时自动降级的备用模型链（逗号分隔；实测这三个在真实聚类 prompt 上稳定出 JSON）
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning:free,dots-studio/dots-3-note-preview:free,cohere/north-mini-code:free

# ---- 信息源扩展（v1.2，全部免 key）----
# 新增源：news_search(Google News 英/中 + Bing News RSS)、cn_media(IT之家/量子位/InfoQ中文/极客公园/雷锋网/Synced/爱范儿)、
#         lobsters、reddit(top.rss 尽力而为)、gh_search(GitHub Search API 近7天新建仓库)
# 质量门槛（硬门槛 + 综合质量分）默认值见 server/src/quality.js DEFAULT_GATES，
# 可在 Web 设置页「质量门槛」分组调整（存 settings 表，下轮扫描生效）。

# ---- Twitter/X（twitterapi.io，可选；留空则禁用该源）----
# 注册送 $0.1 免费额度：https://twitterapi.io
TWITTERAPI_IO_KEY=
# 每轮扫描 X API 最大调用次数（控费）
TWITTER_MAX_CALLS_PER_SCAN=12

# ---- 邮件通知（可选；QQ/163 用"授权码"而非登录密码）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# ---- 浏览器推送（可选；生成：npx web-push generate-vapid-keys）----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
***

# ---- 阈值（也可在 Web 设置页调整）----
# 关键词命中最低置信度（0~1）
AI_NOTIFY_MIN_CONFIDENCE=0.6
# 热点话题通知分数线（0~100）
# 注：话题分数受"证据封顶"约束——仅单一来源且非官方 → 最高 65 分；
#     通知还需满足「跨 ≥2 信息源 或 含官方一手来源」。
TOPIC_NOTIFY_MIN_SCORE=70

# ---- 质量门槛（在 Web 设置页「质量门槛」分组调整，存 settings 表）----
# 各源互动硬门槛：HN points / HF upvotes / GitHub stars / Reddit score / Lobsters score / X likes
# 无互动数据源（官宣/新闻/搜索）走综合质量分 gates.minQuality（默认 60）
# 发布超过 gates.maxAgeDays 天的内容一律拦截（默认 14；trending 与每日论文榜豁免）
